# ============================================
# Git Ignore - EPI Guard (Clean Architecture)
# ============================================

# Ambientes virtuais
.venv/
venv/
env/
ENV/

# Arquivos compilados, caches e ferramentas de qualidade
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Variáveis de ambiente e credenciais
.env
.env.local
*.pem
*.key

# Datasets, Aprendizado Ativo e Pesos de Treinamento
datasets/*
!datasets/custom_ppe_template.yaml
runs/
weights/
*.pt
!models/best.pt
*.onnx
*.engine

# Evidências, logs e bancos locais gerados em runtime
alertas/*
!alertas/.gitkeep
videos_processados.json
relatorio_infracoes.csv
*.log

# Gravações brutas e vídeos temporários remuxados
gravacoes/*
!gravacoes/.gitkeep
!gravacoes/ABC1D23/
!gravacoes/BRA2E19/
*.265
*.hevc
*.h265
*_vlc_clean.mp4

# IDEs e Sistema Operacional
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Distribuição / Build
dist/
build/
*.egg-info/
